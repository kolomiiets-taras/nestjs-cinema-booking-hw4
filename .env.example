# HTTP server
PORT=3000
NODE_ENV=development

# PostgreSQL (used by the app, the TypeORM CLI and docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema
POSTGRES_DB=cinema

# Tokens: access token is a JWT (minutes), refresh token is a random string (days)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10

# First administrator, created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
